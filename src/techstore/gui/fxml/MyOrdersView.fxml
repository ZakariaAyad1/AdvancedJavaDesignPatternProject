<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/15.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="techstore.gui.controller.MyOrdersController"
      spacing="10.0" prefHeight="450.0" prefWidth="600.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <Label text="My Order History" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <TableView fx:id="myOrdersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="80.0" text="Order ID" />
            <TableColumn fx:id="orderDateColumn" prefWidth="150.0" text="Date" />
            <TableColumn fx:id="totalAmountColumn" prefWidth="120.0" text="Total Amount" />
            <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="viewOrderDetailsButton" onAction="#handleViewOrderDetails" text="View Details" />
    </HBox>
</VBox>