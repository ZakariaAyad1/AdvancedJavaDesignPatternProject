<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/15.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="techstore.gui.controller.ClientViewController" 
           prefHeight="550.0" prefWidth="780.0">
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #f0f0f0; -fx-padding: 10;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="Client Navigation" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Button onAction="#handleViewProducts" text="View Products" maxWidth="Infinity"/>
            <Button onAction="#handleViewCart" text="View Shopping Cart" maxWidth="Infinity"/>
            <Button onAction="#handleViewMyOrders" text="My Order History" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label fx:id="clientWelcomeLabel" text="Client Dashboard" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <BorderPane fx:id="clientContentArea" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>