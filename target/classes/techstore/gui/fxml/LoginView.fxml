<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="techstore.gui.controller.LoginController"
      spacing="10"
      alignment="CENTER"
      prefWidth="300"
      prefHeight="250">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="TechStore Login" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Username:" minWidth="80"/>
        <TextField fx:id="usernameField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Password:" minWidth="80"/>
        <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Button fx:id="loginButton" text="Login" onAction="#handleLogin" defaultButton="true"/>
    <Button fx:id="registerButton" text="Register New Client" onAction="#handleRegisterClient"/>
    <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
</VBox>