<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/15.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="techstore.gui.controller.ProductManagementController"
      spacing="10.0" prefHeight="500.0" prefWidth="800.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Product Management" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" onAction="#handleNewProduct" text="Add New Product"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="200.0"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200.0"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="100.0"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150.0"/>
            <TableColumn fx:id="brandColumn" text="Brand" prefWidth="100.0"/>
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="editButton" onAction="#handleEditProduct" text="Edit"/>
        <Button fx:id="deleteButton" onAction="#handleDeleteProduct" text="Delete"/>
    </HBox>
</VBox>