<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/15.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="techstore.gui.controller.ProductDialogController"
      spacing="10" prefWidth="400" styleClass="dialog-pane,card">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
    </padding>

    <Label text="Product Details" styleClass="section-header"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" 
                 GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="categoryComboBox" prefWidth="200" 
                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>        <Label text="Brand:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="brandField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Image:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="5">
            <TextField fx:id="imagePathField" HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#handleImageBrowse"/>
        </HBox>
        <ImageView fx:id="imagePreview" fitHeight="150" fitWidth="200" 
                   preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
    </GridPane>

    <Label fx:id="errorMessageLabel" textFill="red"/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="OK" onAction="#handleOk" styleClass="button,success"/>
        <Button text="Cancel" onAction="#handleCancel" styleClass="button,danger"/>
    </HBox>
</VBox>