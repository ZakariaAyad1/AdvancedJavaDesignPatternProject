<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/15.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="techstore.gui.controller.AdminDashboardController" 
            prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: white;">
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <Label text="ADMIN DASHBOARD" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 20 0;"/>
            
            <Button onAction="#handleManageProducts" text="📦 Manage Products" maxWidth="Infinity"
                    style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 5;"/>
            <Button onAction="#handleManageCategories" text="🏷 Manage Categories" maxWidth="Infinity"
                    style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 5;"/>
            <Button onAction="#handleViewAllOrders" text="🛍 View All Orders" maxWidth="Infinity"
                    style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 5;"/>
            <Button onAction="#handleViewAllUsers" text="👥 View All Users" maxWidth="Infinity"
                    style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 5;"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20.0" style="-fx-background-color: #F8F9FA;">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                
                <!-- Welcome Section -->
                <Label fx:id="adminWelcomeLabel" text="Welcome to Admin Dashboard" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                
                <!-- Statistics Cards -->
                <HBox spacing="15.0">
                    <VBox styleClass="stat-card" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label text="Total Products" style="-fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="totalProductsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2980B9;"/>
                    </VBox>
                    <VBox styleClass="stat-card" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label text="Total Categories" style="-fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="totalCategoriesLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27AE60;"/>
                    </VBox>
                    <VBox styleClass="stat-card" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label text="Total Orders" style="-fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="totalOrdersLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D35400;"/>
                    </VBox>
                    <VBox styleClass="stat-card" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label text="Total Users" style="-fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8E44AD;"/>
                    </VBox>
                </HBox>

                <!-- Recent Orders Section -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label text="Recent Orders" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                    <TableView fx:id="recentOrdersTable" VBox.vgrow="ALWAYS" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="100"/>
                            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="150"/>
                            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="100"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Order Status Distribution -->
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                    </columnConstraints>
                    
                    <VBox GridPane.columnIndex="0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label text="Pending Orders" style="-fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="pendingOrdersLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F39C12;"/>
                    </VBox>
                    
                    <VBox GridPane.columnIndex="1" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label text="Approved Orders" style="-fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="approvedOrdersLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27AE60;"/>
                    </VBox>
                    
                    <VBox GridPane.columnIndex="2" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label text="Rejected Orders" style="-fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="rejectedOrdersLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #C0392B;"/>
                    </VBox>
                </GridPane>

                <!-- Content Area for Other Views -->
                <BorderPane fx:id="adminContentArea" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>