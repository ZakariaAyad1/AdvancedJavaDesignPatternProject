<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/15.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="techstore.gui.controller.ViewAllOrdersController" 
      spacing="10.0" prefHeight="500.0" prefWidth="750.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <Label text="All Customer Orders" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="70.0" text="Order ID" />
            <TableColumn fx:id="clientNameColumn" prefWidth="150.0" text="Client" />
            <TableColumn fx:id="orderDateColumn" prefWidth="120.0" text="Date" />
            <TableColumn fx:id="totalAmountColumn" prefWidth="100.0" text="Total" />
            <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <padding>
            <Insets top="5" />
        </padding>
        <Button text="View Details" onAction="#handleViewOrderDetails"/>
        <Button fx:id="approveButton" 
                text="Approve Order" 
                onAction="#handleApproveOrder"
                style="-fx-background-color: #90EE90; -fx-cursor: hand;"/>
        <Button fx:id="rejectButton" 
                text="Reject Order" 
                onAction="#handleRejectOrder"
                style="-fx-background-color: #FFB6C1; -fx-cursor: hand;"/>
    </HBox>
</VBox>