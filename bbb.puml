@startuml TechStore High-Quality Class Diagram

!define DARKBLUE #00008B
!define LIGHTBLUE #ADD8E6
!define ORANGE #FFA500
!define LIGHTGREEN #90EE90
!define LIGHTPINK #FFB6C1
!define LIGHTYELLOW #FFFFE0
!define LIGHTGREY #D3D3D3
!define PATTERN_BG_COLOR #E6E6FA
!define MODEL_BG_COLOR #FFF0E1
!define MVC_BG_COLOR #E0FFFF

skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 20
skinparam shadowing true
skinparam linetype ortho ' or poly

skinparam class {
    BackgroundColor LIGHTBLUE
    ArrowColor DARKBLUE
    BorderColor DARKBLUE
}

skinparam interface {
    BackgroundColor LIGHTGREEN
    ArrowColor DARKBLUE
    BorderColor DARKBLUE
}

skinparam abstract {
    BackgroundColor LIGHTPINK
    ArrowColor DARKBLUE
    BorderColor DARKBLUE
}

skinparam package {
    RectBackgroundColor LIGHTGREY
    FontColor #333333
}
skinparam package<<Pattern>> {
    RectBackgroundColor PATTERN_BG_COLOR
}
skinparam package<<CoreModel>> {
    RectBackgroundColor MODEL_BG_COLOR
}
skinparam package<<MVC>> {
    RectBackgroundColor MVC_BG_COLOR
}


package "Core Model" <<CoreModel>> {
    class Product implements ProductComponent {
        -id: int
        -name: String
        -description: String
        -price: double
        -category: Category
        -brand: String
        -warrantyMonths: int
        -discount: double
        +Product(id: int, name: String, desc: String, price: double, cat: Category, brand: String, warranty: int, discount: double)
        +getId(): int
        +getName(): String
        +getDescription(): String
        +getPrice(): double
        +setCategory(category: Category): void
    }
    note right of Product : ConcreteComponent for Decorator.\nBuilt by ProductBuilder.

    class Category {
        -id: int
        -name: String
        +Category(name: String)
        +getId(): int
        +getName(): String
    }
    Product "1" *--> "0..1" Category : has a >

    abstract class User {
        #id: int
        #username: String
        #password: String  ' Hashed in real app
        #email: String
        +User(username: String, password: String, email: String)
        +getId(): int
        +getUsername(): String
        +checkPassword(password: String): boolean
        + {abstract} getRole(): String
    }
    note right of User : Abstract product for UserFactory.

    class Admin extends User {
        +Admin(username: String, password: String, email: String)
        +getRole(): String
    }

    class Client extends User {
        -shoppingCart: ShoppingCart
        +Client(username: String, password: String, email: String)
        +getRole(): String
        +getShoppingCart(): ShoppingCart
    }
    Client "1" *--> "1" ShoppingCart : owns >

    class ShoppingCart {
        -client: Client
        -items: List<CartItem>
        +ShoppingCart(client: Client)
        +addProduct(product: ProductComponent, quantity: int): void
        +removeProduct(productId: int): void
        +getTotalCost(): double
        +getItems(): List<CartItem>
        +clearCart(): void
    }
    note right of ShoppingCart::getItems
      Implicitly uses Iterator pattern
      to traverse CartItems.
    end note

    class CartItem {
        -product: ProductComponent
        -quantity: int
        +CartItem(product: ProductComponent, quantity: int)
        +getProduct(): ProductComponent
        +getQuantity(): int
        +getTotalPrice(): double
    }
    ShoppingCart "1" o-- "0..*" CartItem : contains >

    class Order {
        -id: int
        -client: Client
        -orderedItems: List<CartItem>
        -totalAmount: double
        -orderDate: LocalDateTime
        -status: String
        -paymentStrategy: PaymentStrategy
        +Order(client: Client, orderedItems: List<CartItem>, totalAmount: double)
        +processPayment(): boolean
        +setPaymentStrategy(strategy: PaymentStrategy): void
        +getId(): int
        +getClient(): Client
        +getStatus(): String
    }
    note right of Order : Context for PaymentStrategy.\nProcessed by OrderProcessingTemplate.
    Order "1" --|> Client : placed by (navigable)
    Order "1" o-- "1..*" CartItem : consists of >
}

package "MVC Structure" <<MVC>> {
    package "View" <<Node>> {
        class ConsoleView {
            +displayMessage(message: String): void
            +displayProducts(products: List<Product>): void
            +displayShoppingCart(cart: ShoppingCart): void
            +displayProductDetails(product: ProductComponent): void
            +displayCategories(categories: List<Category>): void
            +displayOrders(orders: List<Order>): void
        }
        class InputUtil {
            + {static} getString(prompt: String): String
            + {static} getInt(prompt: String): int
            + {static} getDouble(prompt: String): double
        }
        ConsoleView ..> InputUtil : uses >
    }

    package "Controller" <<Node>> {
        class AppController {
            -view: ConsoleView
            -userManager: UserManager
            -currentUser: User
            -catalogueService: CatalogueService ' Will be a Proxy
            -userFactory: UserFactory
            -orderManager: OrderManager
            +AppController()
            +run(): void
            -login(): void
            -registerClient(): void
        }
        class AdminController {
            -view: ConsoleView
            -admin: Admin
            -catalogueService: CatalogueService ' Proxy
            -commandInvoker: AdminCommandInvoker
            -productFactory: ProductFactory
            +AdminController(view: ConsoleView, admin: Admin, cs: CatalogueService, um: UserManager, om: OrderManager)
            +showAdminMenu(): void
            -manageProducts(): void
            -addProduct(): void
        }
        class ClientController {
            -view: ConsoleView
            -client: Client
            -catalogueService: CatalogueService ' Proxy
            -orderManager: OrderManager
            +ClientController(view: ConsoleView, client: Client, cs: CatalogueService, om: OrderManager)
            +showClientMenu(): void
            -addProductToCart(): void
            -checkout(): void
        }
        AppController "1" --> "1" ConsoleView : uses >
        AppController "1" --> "1" UserManager : uses >
        AppController "1" --> "1" UserFactory : uses >
        AppController "1" ..> AdminController : creates/uses >
        AppController "1" ..> ClientController : creates/uses >

        AdminController "1" --> "1" ConsoleView : uses >
        AdminController "1" --> "1" AdminCommandInvoker : uses >
        ClientController "1" --> "1" ConsoleView : uses >
    }
    Main ..> AppController : creates & runs >
}
class Main {
    + {static} main(args: String[]): void
}


' --- Design Pattern Classes and Integrations ---

package "Pattern: Creational" <<Pattern>> {
    package "Singleton" {
        class UserManager {
            - {static} instance: UserManager
            -users: List<User>
            -notificationService: NotificationService
            -UserManager()
            + {static} getInstance(): UserManager
            +addUser(user: User): void
            +findUserByUsername(username: String): Optional<User>
            +setNotificationService(ns: NotificationService): void
        }
        class CatalogueManager implements CatalogueService {
            - {static} instance: CatalogueManager
            -products: List<Product>
            -categories: List<Category>
            -CatalogueManager()
            + {static} getInstance(): CatalogueManager
            +addProduct(product: Product): void
            +findProductById(id: int): Optional<Product>
            +getAllProducts(): List<Product>
            +addCategory(category: Category): void
            +getAllCategories(): List<Category>
        }
        note on link: CatalogueManager is the RealSubject for CatalogueServiceProxy.
        class OrderManager {
            - {static} instance: OrderManager
            -orders: List<Order>
            -notificationService: NotificationService
            -OrderManager()
            + {static} getInstance(): OrderManager
            +placeOrder(order: Order): void
            +getAllOrders(): List<Order>
            +setNotificationService(ns: NotificationService): void
        }
    }

    package "Factory Method" {
        class UserFactory {
            +createUser(type: UserType, username: String, pass: String, email: String): User
        }
        note "UserType is an enum internal to UserFactory (not shown for brevity)" as UserTypeNote
        UserFactory ..> Admin : <<creates>>
        UserFactory ..> Client : <<creates>>

        class ProductFactory {
            +createProduct(name: String, desc: String, price: double, ...): Product
            +createBasicProduct(name: String, price: double, category: Category): Product
        }
        ProductFactory ..> ProductBuilder : uses >
    }

    package "Builder" {
        class ProductBuilder {
            -id: int
            -name: String
            -price: double
            +ProductBuilder(id: int, name: String, price: double)
            +description(description: String): ProductBuilder
            +category(category: Category): ProductBuilder
            +brand(brand: String): ProductBuilder
            +warrantyMonths(months: int): ProductBuilder
            +discount(discount: double): ProductBuilder
            +build(): Product
        }
        ProductBuilder ..> Product : <<builds>>
    }
}


package "Pattern: Behavioral" <<Pattern>> {
    package "Strategy" {
        interface PaymentStrategy <<Interface>> {
            +pay(amount: double): void
        }
        Order "1" --> "1" paymentStrategy : PaymentStrategy

        class CreditCardPaymentStrategy implements PaymentStrategy {
            -cardNumber: String
            -cvv: String
            -expiryDate: String
            -paymentGateway: ExternalPaymentGateway
            +CreditCardPaymentStrategy(card: String, cvv: String, expiry: String)
            +pay(amount: double): void
        }
        class PayPalPaymentStrategy implements PaymentStrategy {
            -email: String
            -password: String ' Demo only
            -paymentGateway: ExternalPaymentGateway
            +PayPalPaymentStrategy(email: String, password: String)
            +pay(amount: double): void
        }
        ClientController ..> PaymentStrategy : creates/uses >
    }

    package "Command" {
        interface Command <<Interface>> {
            +execute(): void
        }
        AdminCommandInvoker o-- "1" Command : holds & executes >

        class AdminCommandInvoker {
            -command: Command
            +setCommand(cmd: Command): void
            +executeCommand(): void
        }

        abstract class ProductCommand implements Command {
             #catalogueService: CatalogueService
             #product: Product
        }
        class AddProductCommand extends ProductCommand {
            +AddProductCommand(cs: CatalogueService, p: Product)
            +execute(): void
        }
        ' UpdateProductCommand, DeleteProductCommand similar, may not always need product obj
        AdminController ..> Command : creates >
        ProductCommand ..> CatalogueService : uses >
    }

    package "Observer" {
        interface Subject <<Interface>> {
            +registerObserver(o: Observer): void
            +removeObserver(o: Observer): void
            +notifyObservers(message: String): void
        }
        interface Observer <<Interface>> {
            +update(message: String): void
        }
        class NotificationService implements Subject {
            -observers: List<Observer>
            +registerObserver(o: Observer): void
            +removeObserver(o: Observer): void
            +notifyObservers(message: String): void
        }
        NotificationService "1" o-- "0..*" Observer : notifies >
        class AdminNotifier implements Observer {
            -adminName: String
            +AdminNotifier(name: String)
            +update(message: String): void
        }
        UserManager ..> NotificationService : uses >
        OrderManager ..> NotificationService : uses >
    }

    package "Template Method" {
        abstract class OrderProcessingTemplate {
            + {final} processOrder(order: Order, paymentStrategy: PaymentStrategy): void
            #initializeOrder(order: Order): void
            #assignPaymentMethod(order: Order, ps: PaymentStrategy): void
            #validatePayment(order: Order): boolean
            #confirmPayment(order: Order): void
            # {abstract} updateInventory(): void
            # {abstract} notifyClient(order: Order): void
            #finalizeOrder(order: Order): void
        }
        note right of OrderProcessingTemplate::processOrder
          Template Method: Defines algorithm skeleton.
          Primitive operations (updateInventory, notifyClient)
          are implemented by subclasses.
        end note

        class OnlineOrderProcess extends OrderProcessingTemplate {
            #updateInventory(): void
            #notifyClient(order: Order): void
        }
        ClientController ..> OrderProcessingTemplate : uses >
        OrderProcessingTemplate ..> Order : processes >
    }

    package "Iterator" {
      note "Iterator Pattern is implicitly used\nvia Java Collections Framework (e.g., List.iterator()).\nNo custom Iterator classes defined in this project,\nas standard iterators suffice for traversing collections\nin ShoppingCart, CatalogueManager, ConsoleView, etc." as IteratorPatternNote
    }
}

package "Pattern: Structural" <<Pattern>> {
    package "Decorator" {
        interface ProductComponent <<Interface>> {
            +getId(): int
            +getName(): String
            +getDescription(): String
            +getPrice(): double
        }
        CartItem "1" o-- "1" ProductComponent : contains decorated or base >

        abstract class ProductDecorator implements ProductComponent {
            #wrappedProduct: ProductComponent
            +ProductDecorator(wrapped: ProductComponent)
            +getId(): int ' Delegates
            +getName(): String ' May augment
            +getDescription(): String ' May augment
            +getPrice(): double ' May augment
        }
        ProductDecorator "1" o-- "1" ProductComponent : decorates >

        class GiftWrapDecorator extends ProductDecorator {
            +GiftWrapDecorator(wrapped: ProductComponent)
            +getPrice(): double ' Adds cost
            +getName(): String ' Appends "(Gift Wrapped)"
        }
        class ExtendedWarrantyDecorator extends ProductDecorator {
            -extraYears: int
            +ExtendedWarrantyDecorator(wrapped: ProductComponent, years: int)
            +getPrice(): double ' Adds cost per year
            +getName(): String ' Appends "(+Nyr Warranty)"
        }
        ClientController ..> ProductDecorator : creates/uses >
    }

    package "Adapter" {
        interface ExternalPaymentGateway <<Interface>> {
            ' Target interface for payment processing
            +processPayment(amount: double): boolean
        }
        CreditCardPaymentStrategy "1" --> "1" ExternalPaymentGateway : uses >
        PayPalPaymentStrategy "1" --> "1" ExternalPaymentGateway : uses >

        class PayPalApi {
            ' Adaptee: External PayPal API (simulated)
            +sendPayment(email: String, totalAmount: double): void
        }
        class CreditCardApi {
            ' Adaptee: External Credit Card API (simulated)
            +chargeCreditCard(cardNumber: String, expiry: String, cvv: String, amount: double): boolean
        }

        class PayPalAdapter implements ExternalPaymentGateway {
            -payPalApi: PayPalApi
            +PayPalAdapter(api: PayPalApi)
            +processPayment(amount: double): boolean
        }
        PayPalAdapter ..|> PayPalApi : adapts >

        class CreditCardAdapter implements ExternalPaymentGateway {
            -creditCardApi: CreditCardApi
            +CreditCardAdapter(api: CreditCardApi)
            +processPayment(amount: double): boolean
        }
        CreditCardAdapter ..|> CreditCardApi : adapts >
    }

    package "Proxy" {
        interface CatalogueService <<Interface>> {
            ' Subject interface for catalogue operations
            +addProduct(product: Product): void
            +updateProduct(product: Product): void
            +deleteProduct(productId: int): void
            +findProductById(productId: int): Optional<Product>
            +getAllProducts(): List<Product>
            +addCategory(category: Category): void
            +getAllCategories(): List<Category>
        }
        AppController "1" --> "1" catalogueService : CatalogueService
        AdminController "1" --> "1" catalogueService : CatalogueService
        ClientController "1" --> "1" catalogueService : CatalogueService

        class CatalogueServiceProxy implements CatalogueService {
            ' Proxy controlling access to RealSubject
            -realCatalogueService: CatalogueManager
            -currentUser: User
            +CatalogueServiceProxy(user: User)
            +addProduct(product: Product): void ' Checks admin rights
            ' ... other methods delegate or control access
        }
        CatalogueServiceProxy "1" ..> CatalogueManager : delegates to >
        CatalogueServiceProxy "1" ..> User : checks role of >
    }
}

' --- General Relationships and Dependencies ---
AppController ..> OrderManager : uses >
AdminController ..> CatalogueService : uses >
ClientController ..> CatalogueService : uses >
ClientController ..> OrderManager : uses >

note bottom of Main
  Entry point of the application.
  Initializes and runs the AppController.
end note
@enduml